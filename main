
-- N4TH LOADER
-- Check latest commit, then download cit.lua

assert(type(loadstring) == "function",
    "[n4th] Executor tidak menyediakan loadstring.")

local repository = "farelfirmansyah323-dot/growbloxcit"
local branch = "main"
local filename = "cit.lua"

local httpService = game:GetService("HttpService")
local lastError = "respons kosong"

local function download(url)
    local err = "respons kosong"

    local function checked(source)
        if type(source) ~= "string" or source:match("^%s*$") then
            return nil, "respons kosong"
        end

        if source:match("^%s*<") then
            return nil, "Server mengirim HTML, bukan script."
        end

        return source
    end

    local ok, source = pcall(function()
        return game:HttpGet(url)
    end)

    if ok then
        local valid, reason = checked(source)
        if valid then
            return valid
        end
        err = reason
    else
        err = tostring(source)
    end

    local seen = {}

    local requestFunctions = {
        request,
        http_request,
        syn and syn.request,
        http and http.request
    }

    for _, api in ipairs(requestFunctions) do
        if type(api) == "function" and not seen[api] then
            seen[api] = true

            local sent, response = pcall(api, {
                Url = url,
                Method = "GET"
            })

            if sent and type(response) == "table" then
                local status = tonumber(
                    response.StatusCode or response.Status
                )

                if status and (status < 200 or status >= 300) then
                    err = "HTTP " .. tostring(status)
                else
                    local valid, reason = checked(
                        response.Body or response.body
                    )

                    if valid then
                        return valid
                    end

                    err = reason
                end
            else
                err = tostring(response)
            end
        end
    end

    error("[n4th] Unduh gagal: " .. tostring(err), 0)
end

local function latestSource()
    local refUrl =
        "https://api.github.com/repos/"
        .. repository
        .. "/git/ref/heads/"
        .. branch
        .. "?update="
        .. httpService:GenerateGUID(false)

    local ref = httpService:JSONDecode(download(refUrl))

    local commit =
        type(ref) == "table"
        and type(ref.object) == "table"
        and ref.object.sha

    if type(commit) ~= "string"
        or #commit ~= 40
        or not commit:match("^%x+$") then

        local reason =
            type(ref) == "table"
            and ref.message
            or "Metadata tidak valid"

        error("[n4th] Gagal mengecek update: "
            .. tostring(reason), 0)
    end

    local rawUrl =
        "https://raw.githubusercontent.com/"
        .. repository
        .. "/"
        .. commit
        .. "/"
        .. filename

    return download(rawUrl), commit
end

for attempt = 1, 3 do
    local ok, source, commit = pcall(latestSource)

    if ok then
        local fn, compileError = loadstring(source, "cit")

        if not fn then
            error("[n4th] Gagal compile: "
                .. tostring(compileError), 0)
        end

        print("[n4th] Menjalankan commit "
            .. commit:sub(1, 8))

        local ran, result = xpcall(fn, function(err)
            if debug and type(debug.traceback) == "function" then
                return debug.traceback(tostring(err), 2)
            end
            return tostring(err)
        end)

        if not ran then
            error("[n4th] Runtime error:\n"
                .. tostring(result), 0)
        end

        return result
    end

    lastError = tostring(source)

    warn("[n4th] Percobaan " .. attempt
        .. " gagal: " .. lastError)

    if attempt < 3 then
        task.wait(1)
    end
end

error("[n4th] Gagal mengambil update setelah 3 percobaan: "
    .. lastError, 0)
